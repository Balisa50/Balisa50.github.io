# Contact form destination, from web3forms.com (free, no card required).
#
# Public by design: the key identifies which inbox a submission is forwarded to
# and grants no read access. Without it the form does not render at all, and the
# email and phone links next to it still work.
#
# Set it in the repository's Actions secrets/variables as well, or the deployed
# build will not have it at build time.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Raises the GitHub API rate limit for the star counts.
GITHUB_TOKEN=
