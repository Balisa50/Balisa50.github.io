{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs dev",
    "build": "node scripts/build.mjs server",
    "build:static": "node scripts/build.mjs export",
    "build:standalone": "node scripts/build.mjs standalone",
    "start": "next start",
    "diagrams": "node scripts/generate-diagrams.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t balisa-portfolio .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local balisa-portfolio",
    "audio": "node scripts/generate-hero-audio.mjs --force",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "geist": "^1.3.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.2.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  }
}
